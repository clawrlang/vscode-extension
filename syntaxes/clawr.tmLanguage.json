{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Clawr",
  "scopeName": "source.clawr",
  "fileTypes": ["clawr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#regex" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.clawr",
          "match": "//.*$"
        },
        {
          "name": "comment.block.clawr",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.clawr" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.clawr",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.clawr", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.clawr",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.clawr", "match": "\\\\." }
          ]
        }
      ]
    },
    "regex": {
      "patterns": [
        {
          "name": "string.regexp.clawr",
          "begin": "/",
          "end": "/(i|m|s|x)*",
          "patterns": [
            { "name": "constant.character.escape.clawr", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.clawr",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.clawr",
          "match": "\\b(const|mut|ref|func|pure|operator|enum|union|data|object|companion|service|role|trait)\\b"
        },
        {
          "name": "keyword.control.clawr",
          "match": "\\b(if|else|guard|switch|when|case|do|while|for|in|break|continue|return|throw|throws|try|catch)\\b"
        },
        {
          "name": "keyword.operator.clawr",
          "match": "\\b(and|or|is)\\b"
        },
        {
          "name": "keyword.modifier.clawr",
          "match": "\\b(self|super|inheritance|helper|mutating|atomic|concurrent)\\b"
        },
        {
          "name": "keyword.import.clawr",
          "match": "\\b(import|from|as)\\b"
        },
        {
          "name": "constant.language.clawr",
          "match": "\\b(true|false|ambiguous)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.clawr",
          "match": "\\b(print|println|len|type|panic|assert)\\b"
        },
        {
          "name": "entity.name.function.clawr",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.clawr",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.clawr",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|&&=|\\|\\|=|\\[>)"
        },
        {
          "name": "keyword.operator.logical.clawr",
          "match": "(&&|\\|\\||!(?!=))"
        },
        {
          "name": "keyword.operator.comparison.clawr",
          "match": "(===|!==|==|!=|≠|<=|>=|≤|≥|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.clawr",
          "match": "(\\+|-|\\*|/|%|~|\\^|<<|>>)"
        },
        {
          "name": "keyword.operator.bitwise.clawr",
          "match": "(&|\\||\\^|~|<<|>>)"
        },
        {
          "name": "keyword.operator.special.clawr",
          "match": "(\\|>|->|=>|\\?\\.|\\.\\.\\.|\\.\\.|\\.\\.< |\\?\\?|=)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.clawr",
          "match": "[{}\\[\\](),.;:]"
        }
      ]
    }
  }
}
