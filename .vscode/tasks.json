{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "isBackground": false,
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^\\(]*\\([^)]*\\)|[^:]*:[^:]*): (error|warning|info) TS\\d+: (.*)$",
          "file": 1,
          "severity": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": false,
          "beginsPattern": "^npm run build",
          "endsPattern": "^\\s*$"
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "label": "npm: test",
      "detail": "bun test tests/unit"
    }
  ]
}
